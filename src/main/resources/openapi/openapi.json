        "summary" : "Build the Google consent URL (access_type=offline&prompt=consent for a refresh token) with a signed CSRF state binding this principal. Use-gated + owner-scoped.",
        "operationId" : "googleAuthorizeUrl",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthorizeUrl"
                }
              }
            }
          }
        }
      }
    },
    "/bff/tube/admin/access/{accessType}/{userSubject}" : {
      "delete" : {
        "tags" : [ "Tube Use Access" ],
        "summary" : "RESTORE/REVOKE: lift the active override of a type for a user (CAS active->revoked; the row is retained = audit). accessType = use|banned: revoke 'banned' to restore use; revoke 'use' to remove a grant. ADMIN/SUPERADMIN, own-brand.",
        "operationId" : "revokeUseAccess",
        "parameters" : [ {
          "name" : "accessType",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "userSubject",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
