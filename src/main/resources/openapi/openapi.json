              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Access"
                }
              }
            }
          }
        }
      }
    },
    "/bff/tube/superadmin/access" : {
      "get" : {
        "tags" : [ "Tube Use Access" ],
        "summary" : "List all ACTIVE tube_access overrides (scoped to the caller's brand; SUPERADMIN sees all). SUPERADMIN.",
        "operationId" : "listActiveUseAccess",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
