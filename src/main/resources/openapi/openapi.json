                }
              }
            }
          }
        }
      }
    },
    "/bff/tube/admin/access/timeout" : {
      "post" : {
        "tags" : [ "Tube Use Access" ],
        "summary" : "TIMEOUT a USER from the tube service for a bounded window (an active banned override with a future expires_at; auto-restores on expiry). ADMIN/SUPERADMIN, own-brand.",
        "operationId" : "timeoutUseAccess",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Timeout"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Access"
                }
              }
            }
          }
        }
      }
    },
    "/bff/tube/admin/access/grant" : {
      "post" : {
        "tags" : [ "Tube Use Access" ],
        "summary" : "GRANT a USER permanent may-use access (an active tube_access use override) — the way to lift a user above the default-deny use floor. ADMIN/SUPERADMIN, own-brand.",
        "operationId" : "grantUseAccess",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/GrantOrBan"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Access"
                }
              }
            }
          }
        }
      }
    },
    "/bff/tube/admin/access/ban" : {
      "post" : {
        "tags" : [ "Tube Use Access" ],
        "summary" : "BAN a USER from the tube service permanently (an active banned override, expires_at NULL). Denies even an active grantee (ban>grant). ADMIN/SUPERADMIN, own-brand.",
        "operationId" : "banUseAccess",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/GrantOrBan"
              }
            }
          },
          "required" : true
