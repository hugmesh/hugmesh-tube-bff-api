                }
              }
            }
          }
        }
      }
    },
    "/bff/tube/subscriptions" : {
      "get" : {
        "tags" : [ "Tube Subscriptions" ],
        "summary" : "List the current user's stored subscribed channels (owner-scoped; no network call). Use-gated.",
        "operationId" : "listSubscriptions",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
