{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "snapdragon-tube-bff-api",
    "description" : "Tube BFF API (/bff/tube/**) — the access governance plane for the LocalTube video optional service. PR2 owns the tube_access use/timeout/ban overlay (cloned from owncast_grant / wiki_access): DEFAULT-DENY may-use enforced at request time by TubeAccessGuard (an active use grant AND NOT an active ban, precedence ban>grant, SUPERADMIN exempt). Grant/timeout/ban/restore gated TUBE_GOVERN (admin|superadmin); list-all/history gated TUBE_MANAGE (superadmin). All surfaces are domain-scoped per multi-brand: a scoped ADMIN governs only own-brand users. The Google-connect/subs-sync, the yt-dlp downloader, and the per-domain content media serving (range/HLS) are SEPARATE components, not this BFF.",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "name" : "Tube Storage Budget (admin)",
    "description" : "ADMIN sets a user's download storage budget cap (ADMIN|SUPERADMIN). Brand server-derived (own-brand only)."
  }, {
    "name" : "Tube Subscriptions",
    "description" : "List + sync a user's subscribed YouTube channels. Gated by the tube_access use overlay (TubeAccessGuard) + owner-scope (server-derived subject+brand, fail-closed). A failed refresh sets reauth_required and STOPS the sync."
  }, {
    "name" : "Tube Google Connect",
    "description" : "Connect/callback/disconnect a user's Google (youtube.readonly) account. Gated by the tube_access use overlay (TubeAccessGuard) + owner-scope (server-derived subject+brand, fail-closed). The refresh token is AES-256-GCM-encrypted at rest and NEVER returned."
  }, {
    "name" : "Tube Downloads",
    "description" : "The user's download work-queue: list own jobs + enqueue from subscriptions. Default-deny use (TubeAccessGuard) enforced first; owner + brand are server-derived from the JWT (no cross-user/cross-brand access)."
  }, {
    "name" : "Tube Use Access",
    "description" : "Tube use grant/timeout/ban overlay (tube_access): grant/timeout/ban/restore (TUBE_GOVERN), list-all/history (TUBE_MANAGE). Domain-scoped; use is DEFAULT-DENY, enforced at request time by TubeAccessGuard (an active use grant AND NOT an active ban, SUPERADMIN exempt)."
  }, {
    "name" : "Tube Media Signing",
    "description" : "Short-TTL HMAC-signed media URLs for the tube-media Nginx sidecar. Owner two-wall: ROLE_TUBE at gateway (wall 1) + path owner==jwt.subject (wall 2). Signed URL binds user, domain, path, and expiry; TTL = 5 min."
  }, {
    "name" : "Tube Download Worker (internal)",
    "description" : "INTERNAL claim/report seam for the future yt-dlp downloader CronJob. ROLE_TUBE_WORKER (service principal) ONLY — NOT reachable by ROLE_TUBE users or any human role."
  } ],
  "paths" : {
    "/bff/tube/subscriptions/sync" : {
      "post" : {
        "tags" : [ "Tube Subscriptions" ],
        "summary" : "Sync the current user's subscriptions from Google (refresh -> page subscriptions.list?mine=true -> idempotent UPSERT). A failed refresh marks reauth_required and STOPS. Use-gated + owner-scoped.",
        "operationId" : "syncSubscriptions",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SyncResult"
                }
              }
            }
          }
        }
      }
    },
    "/bff/tube/internal/download-jobs/report" : {
      "post" : {
        "tags" : [ "Tube Download Worker (internal)" ],
        "summary" : "WORKER reports a job result (done stamps bytes+path and accounts storage; failed stamps the error; downloading marks progress). ROLE_TUBE_WORKER only.",
        "operationId" : "reportDownloadJob",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ReportRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Job"
                }
              }
            }
          }
        }
      }
    },
    "/bff/tube/internal/download-jobs/claim" : {
      "post" : {
        "tags" : [ "Tube Download Worker (internal)" ],
        "summary" : "WORKER claims up to N queued jobs (atomic — each job to exactly one worker; pause-on-full honoured). ROLE_TUBE_WORKER only.",
        "operationId" : "claimDownloadJobs",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ClaimRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JobList"
                }
              }
            }
          }
        }
      }
    },
    "/bff/tube/google-connect/disconnect" : {
      "post" : {
        "tags" : [ "Tube Google Connect" ],
        "summary" : "Disconnect: best-effort revoke the token at Google, then soft-revoke the connection (audit-retained). Use-gated + owner-scoped.",
        "operationId" : "googleDisconnect",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConnectStatus"
                }
              }
            }
          }
        }
      }
    },
    "/bff/tube/downloads" : {
      "get" : {
        "tags" : [ "Tube Downloads" ],
        "summary" : "List the calling user's OWN download jobs (owner + brand server-derived). Default-deny use enforced first.",
        "operationId" : "listDownloadJobs",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JobList"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Tube Downloads" ],
        "summary" : "Enqueue download jobs from the calling user's subscriptions (deduped; pause-on-full marks new work skipped when the storage budget is full). Owner + brand server-derived. Default-deny use enforced first.",
        "operationId" : "enqueueDownloadJobs",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JobList"
                }
              }
            }
          }
        }
      }
    },
    "/bff/tube/admin/storage-budget" : {
      "post" : {
        "tags" : [ "Tube Storage Budget (admin)" ],
        "summary" : "Set a target user's download storage budget (bytes). ADMIN/SUPERADMIN, own-brand (brand server-derived).",
        "operationId" : "setStorageBudget",
        "requestBody" : {
