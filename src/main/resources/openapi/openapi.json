    },
    "/bff/tube/media/sign" : {
      "get" : {
        "tags" : [ "Tube Media Signing" ],
        "summary" : "Sign a short-TTL (5 min) media URL for the calling user's own content. Default-deny use (TubeAccessGuard) enforced first. Path must start with /<domain>/<subject>/. Returns signed URL + expiresAt. 403 if no use grant / banned; 403 if path owner != jwt.subject; 400 if path is malformed.",
        "operationId" : "signMediaUrl",
        "parameters" : [ {
          "name" : "path",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SignedUrl"
                }
              }
            }
          }
        }
      }
    },
    "/bff/tube/google-connect/status" : {
      "get" : {
        "tags" : [ "Tube Google Connect" ],
        "summary" : "The current user's Google connection status (display-safe; never exposes the refresh token). Use-gated + owner-scoped.",
        "operationId" : "googleConnectStatus",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConnectStatus"
                }
              }
            }
          }
        }
      }
    },
    "/bff/tube/google-connect/callback" : {
      "get" : {
        "tags" : [ "Tube Google Connect" ],
        "summary" : "Google's OAuth redirect target: verify the signed state, exchange the code, AES-256-GCM-encrypt + store the refresh token. The state binds the principal (the callback hop carries no bearer of its own). Use-gated + owner-scoped.",
        "operationId" : "googleConnectCallback",
        "parameters" : [ {
          "name" : "code",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "state",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
